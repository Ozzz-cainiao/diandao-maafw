{
  "QuickTaobaoDaily": {
    "action": "StartApp",
    "package": "com.taobao.taobao",
    "post_delay": 2500,
    "timeout": 15000,
    "next": [
      "QuickEnterCoins",
      "QuickCoinPage"
    ],
    "focus": {
      "Node.Action.Starting": "启动淘宝；请勿切换其他 App"
    }
  },
  "QuickEnterCoins": {
    "recognition": "OCR",
    "expected": "^领淘金币$",
    "roi": [
      0,
      80,
      720,
      850
    ],
    "threshold": 0.7,
    "action": "Click",
    "max_hit": 1,
    "post_delay": 2500,
    "timeout": 15000,
    "next": [
      "QuickCoinPage"
    ],
    "focus": {
      "Node.Action.Starting": "进入淘金币页面"
    }
  },
  "QuickClaimOnce": {
    "recognition": "And",
    "all_of": [
      {
        "recognition": "OCR",
        "expected": "淘金币",
        "roi": [
          0,
          45,
          310,
          135
        ],
        "threshold": 0.7
      },
      {
        "recognition": "OCR",
        "expected": "^签到领金币$",
        "roi": [
          0,
          130,
          720,
          500
        ],
        "threshold": 0.7
      }
    ],
    "box_index": 1,
    "action": "Click",
    "max_hit": 1,
    "post_delay": 1200,
    "timeout": 12000,
    "next": [
      "QuickCheckClaimAbsent"
    ],
    "focus": {
      "Node.Action.Starting": "点击签到一次，等待页面确认；失败不会重复点击"
    }
  },
  "QuickCheckClaimAbsent": {
    "recognition": "OCR",
    "expected": "^签到领金币$",
    "roi": [
      0,
      130,
      720,
      500
    ],
    "threshold": 0.7,
    "inverse": true,
    "action": "DoNothing",
    "timeout": 12000,
    "next": [
      "QuickConfirmClaimed"
    ]
  },
  "QuickConfirmClaimed": {
    "recognition": "And",
    "all_of": [
      {
        "recognition": "OCR",
        "expected": "淘金币",
        "roi": [
          0,
          45,
          310,
          135
        ],
        "threshold": 0.7
      },
      {
        "recognition": "OCR",
        "expected": "^今天$",
        "roi": [
          0,
          155,
          300,
          250
        ],
        "threshold": 0.7
      },
      {
        "recognition": "OCR",
        "expected": "赚更多金币",
        "roi": [
          0,
          260,
          720,
          450
        ],
        "threshold": 0.7
      }
    ],
    "action": "DoNothing",
    "timeout": 3000,
    "next": [
      "QuickEntry"
    ],
    "focus": {
      "Node.Recognition.Succeeded": "已识别签到后的页面标记，检查签到按钮是否仍然消失"
    }
  },
  "QuickCoinPage": {
    "recognition": "OCR",
    "expected": "^淘金币$",
    "roi": [
      0,
      45,
      310,
      135
    ],
    "threshold": 0.7,
    "timeout": 12000,
    "next": [
      "QuickClaimOnce",
      "QuickCheckClaimAbsent"
    ]
  },
  "QuickEntry": {
    "recognition": "OCR",
    "expected": "^(40秒快速赚|快速赚)$",
    "threshold": 0.7,
    "action": "Click",
    "max_hit": 1,
    "post_delay": 1500,
    "timeout": 10000,
    "next": [
      "QuickAllDone"
    ],
    "focus": {
      "Node.Action.Starting": "进入快速赚核对；本阶段不会执行待领奖任务"
    }
  },
  "QuickAllDone": {
    "recognition": "And",
    "all_of": [
      {
        "recognition": "OCR",
        "expected": "^今日速赚$",
        "threshold": 0.7
      },
      {
        "recognition": "OCR",
        "expected": "今日快速赚奖励已拿完",
        "threshold": 0.7
      }
    ],
    "action": "ClickKey",
    "key": 3,
    "timeout": 10000,
    "focus": {
      "Node.Action.Succeeded": "已识别今日快速赚奖励全部完成，已发送HOME；未核实余额"
    }
  }
